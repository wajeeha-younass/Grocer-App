<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".CheckoutActivity">

    <!-- Toolbar with Back Button and Title -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/orange"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:src="@drawable/arrow"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checkout"
            android:layout_gravity="start|center_vertical"
            android:textSize="18sp"
            android:textColor="#FFFFFF" />
    </androidx.appcompat.widget.Toolbar>


    <!-- Progress Indicator -->
    <LinearLayout
        android:id="@+id/progressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/toolbar"
        android:padding="16dp"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1. Your Bill"
            android:textColor="#4CAF50"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2. Place Order"
            android:textColor="#4CAF50"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3. Completed"
            android:textColor="#888888"
            android:gravity="center" />
    </LinearLayout>

    <!-- Delivery Option Section -->
    <TextView
        android:id="@+id/tvDeliveryOption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/progressIndicator"
        android:padding="16dp"
        android:text="Delivery Option"
        android:textColor="#000000"
        android:textSize="16sp" />

    <RadioGroup
        android:id="@+id/radioGroupDeliveryOption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvDeliveryOption"
        android:orientation="vertical"
        android:paddingStart="16dp">

        <RadioButton
            android:id="@+id/radioScheduledDelivery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scheduled Delivery"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvFreeDelivery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:text="Earliest slot 09:00 - 12:00 PM Tomorrow"
            android:textColor="#4CAF50"
            android:textSize="14sp" />
    </RadioGroup>

    <!-- Delivery Day and Window Section -->
    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@id/radioGroupDeliveryOption"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Delivery Day Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivery Day"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvDeliveryDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tomorrow"
            android:textColor="#FF9800"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Delivery Window Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivery Window"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvDeliveryWindow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:00 - 12:00 PM"
            android:textColor="#FF9800"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>

<!--    &lt;!&ndash; Delivery Location Section with Google Map Placeholder &ndash;&gt;-->
<!--    <TextView-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_below="@id/radioGroupDeliveryOption"-->
<!--        android:padding="16dp"-->
<!--        android:text="Delivery Location"-->
<!--        android:textColor="#000000"-->
<!--        android:textSize="16sp" />-->

    <!-- Payment Method and Place Order Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:padding="16dp"
        android:background="#FFF">

        <TextView
            android:id="@+id/tvPaymentMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Payment Method"
            android:textColor="#000000"
            android:textSize="16sp" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioCashOnDelivery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cash on Delivery" />
        </RadioGroup>

        <!-- Place Order Button -->
        <Button
            android:id="@+id/btnPlaceOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLACE ORDER"
            android:backgroundTint="#FFA000"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</RelativeLayout>
